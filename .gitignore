# Large model artifacts & serialized weights (keep directory structure with .gitkeep)
artifacts/*.joblib
artifacts/*.pkl
artifacts/*.model
artifacts/*.bin
artifacts/*.h5
artifacts/*.onnx
!artifacts/.gitkeep

# Large temporary datasets (keep raw and keep directories)
data/processed/*.parquet
data/interim/*
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep

# Local scratch and logs
scratch/
*.log
